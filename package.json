{
  "name": "tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local cockpit for Claude Code and Codex CLI working in tandem.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "concurrently -k -n api,ui -c yellow,cyan \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "server": "node server/index.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.2"
  }
}
