{
  "name": "tandem",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Local cockpit for Claude Code and Codex CLI working in tandem.",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "concurrently -k -n api,ui -c yellow,cyan \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "server": "node server/index.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.tandem.local",
    "productName": "Tandem",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "scripts/**",
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "scripts",
        "to": "app/scripts"
      }
    ],
    "win": {
      "icon": "build/tandem-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tandem-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Tandem-${version}-Portable.exe"
    }
  }
}
